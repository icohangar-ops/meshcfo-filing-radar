# MeshCFO Filing Radar configuration.
# Defaults need NO keys and make NO network calls: inference is a local
# open-weight GGUF model, and every external service is disabled.

# --- Local inference (default) ---------------------------------------
# MESHCFO_INFERENCE=local        # local | offline | live
# MESHCFO_LOCAL_MODEL=~/workspace/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
# MESHCFO_LOCAL_LLM_ASK_PY=~/workspace/tools/local-llm/ask.py

# --- External services (OFF by default) --------------------------------
# Set to 1 ONLY if you deliberately want cloud calls (live Nebius LLM
# and/or Tavily). With it unset, keys below are ignored at runtime.
# MESHCFO_ENABLE_EXTERNAL=0

# Nebius Token Factory — used only by MESHCFO_INFERENCE=live when
# external services are enabled. Get a key at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=
# NEBIUS_API_KEY_FILE=/path/to/nebius.tokenfactory.key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_TRIAGE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_DEEPEN_MODEL=nvidia/Nemotron-3_5-Lightning

# Tavily — market context only, never EDGAR evidence; also opt-in only.
TAVILY_API_KEY=
# TAVILY_API_KEY_FILE=/path/to/tavily.api.key
